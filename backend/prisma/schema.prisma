// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Desempenho {
  id            Int      @id @default(autoincrement())
  aluno         String
  competencia   String
  totalQuestoes Int
  acertos       Int
  meta          Int
  criadoEm      DateTime @default(now())
  professorId Int?
  alunoId     Int?
}

// Define os perfis de acesso do sistema.
enum Perfil {
  PROFESSOR
  ALUNO
}

// Guarda os dados usados no login.
model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil   @default(ALUNO)
  criadoEm  DateTime @default(now())

  trocarSenha Boolean @default(false)

  versaoToken Int @default(0)

  recuperacaoTokenHash String?   @unique
recuperacaoExpiraEm  DateTime?

  // Ficam vazios até o usuário aceitar os termos.
  termosAceitosEm DateTime?
  versaoTermos    String?

  // Liga o aluno ao professor responsável.
  professorId Int?
  professor   Usuario?  @relation("ProfessorAlunos", fields: [professorId], references: [id])
  alunos      Usuario[] @relation("ProfessorAlunos")
}
// Registra as ações realizadas no sistema.
model LogAuditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  acao      String
  alvoId    Int?
  criadoEm  DateTime @default(now())

  // Facilita a consulta das ações de cada usuário por data.
  @@index([usuarioId, criadoEm])
}