// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Desempenho {
  id            Int      @id @default(autoincrement())
  aluno         String
  competencia   String
  totalQuestoes Int
  acertos       Int
  meta          Int
  criadoEm      DateTime @default(now())
}